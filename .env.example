# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Local database (docker compose). Defaults match docker-compose.yml.
DB_NAME=speclens
DB_USER=speclens
DB_PASSWORD=speclens
DB_PORT=5433

# JDBC URL the app uses. Locally this points at docker compose;
# in production it points at Neon (append ?sslmode=require).
DB_URL=jdbc:postgresql://localhost:5433/speclens

# Gemini API key (used from Feature 2 onwards). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: chat model for answers. Default gemini-3.5-flash-lite (generous free tier).
# gemini-3.5-flash handles paraphrased questions better but allows only 20 requests/day free.
# GEMINI_CHAT_MODEL=gemini-3.5-flash

# Optional: local demo mode (what the public deployment uses)
# DEMO_SEED=true
# UPLOAD_ENABLED=false
